# Plantilla de configuracion.
#
# COMO USARLO:
#   1. Copiar este archivo con el nombre .env
#   2. Completar DB_PASSWORD con la contrasena de PostgreSQL
#
# Este archivo SI se sube al repositorio (no tiene datos reales).
# El .env NO se sube nunca.
# ================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ies9_gestion
DB_USER=postgres
DB_PASSWORD=escribir_aca_la_contrasena
SECRET_KEY=generar_con_python_secrets_token_hex_32

# ── Correo (envío de tokens de inscripción) ────────────────────
# Cuenta de Gmail del instituto con verificación en dos pasos y una
# "contraseña de aplicación" (16 letras). No usar la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=cuenta.del.instituto@gmail.com
SMTP_CONTRASENA=escribir_aca_la_contrasena_de_aplicacion
SMTP_REMITENTE=cuenta.del.instituto@gmail.com
SMTP_NOMBRE=IES N 9 Juana Azurduy
# Dirección pública del sistema, para el enlace del correo
SGA_URL_PUBLICA=https://sga-ies9.tail145f3c.ts.net
